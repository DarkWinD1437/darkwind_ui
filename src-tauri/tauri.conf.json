{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "darkwind_ui",
  "version": "0.1.0",
  "identifier": "com.darkwind.darkwind_ui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DarkWinD_UI",
        "width": 800,
        "height": 600,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/geoip/GeoLite2-City.mmdb": "geoip/GeoLite2-City.mmdb",
      "resources/geoip/GeoLite2-ASN.mmdb": "geoip/GeoLite2-ASN.mmdb",
      "resources/geoip/GeoLite2-Country.mmdb": "geoip/GeoLite2-Country.mmdb"
    }
  }
}
